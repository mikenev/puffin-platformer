class_name PixelFont
extends RefCounted
## Original 3x5 bitmap font drawn as 1px rects, so UI text is always pixel-perfect at 256x224.
## Each glyph is 5 rows of 3 bits ("1" = lit). Lowercase is drawn as uppercase.

const W := 3
const H := 5
const ADVANCE := 4
const GLYPHS := {
	"A": ["010","101","111","101","101"], "B": ["110","101","110","101","110"],
	"C": ["011","100","100","100","011"], "D": ["110","101","101","101","110"],
	"E": ["111","100","110","100","111"], "F": ["111","100","110","100","100"],
	"G": ["011","100","101","101","011"], "H": ["101","101","111","101","101"],
	"I": ["111","010","010","010","111"], "J": ["001","001","001","101","010"],
	"K": ["101","101","110","101","101"], "L": ["100","100","100","100","111"],
	"M": ["101","111","111","101","101"], "N": ["110","101","101","101","101"],
	"O": ["010","101","101","101","010"], "P": ["110","101","110","100","100"],
	"Q": ["010","101","101","110","011"], "R": ["110","101","110","101","101"],
	"S": ["011","100","010","001","110"], "T": ["111","010","010","010","010"],
	"U": ["101","101","101","101","111"], "V": ["101","101","101","101","010"],
	"W": ["101","101","111","111","101"], "X": ["101","101","010","101","101"],
	"Y": ["101","101","010","010","010"], "Z": ["111","001","010","100","111"],
	"0": ["111","101","101","101","111"], "1": ["010","110","010","010","111"],
	"2": ["110","001","010","100","111"], "3": ["110","001","010","001","110"],
	"4": ["101","101","111","001","001"], "5": ["111","100","110","001","110"],
	"6": ["011","100","111","101","111"], "7": ["111","001","010","010","010"],
	"8": ["111","101","111","101","111"], "9": ["111","101","111","001","110"],
	"-": ["000","000","111","000","000"], ":": ["000","010","000","010","000"],
	"*": ["000","101","010","101","000"], ".": ["000","000","000","000","010"],
	"!": ["010","010","010","000","010"], ">": ["100","110","111","110","100"],
	"<": ["001","011","111","011","001"], "/": ["001","001","010","100","100"],
	"|": ["010","010","010","010","010"], "#": ["000","111","111","111","000"],
	"?": ["110","001","010","000","010"],
}

static func text_width(text: String, scale := 1) -> int:
	return maxi(text.length() * ADVANCE - 1, 0) * scale

static func draw_text(ci: CanvasItem, text: String, pos: Vector2, color: Color, scale := 1, shadow := Color(0, 0, 0, 0)) -> void:
	if shadow.a > 0.0:
		_draw_run(ci, text, pos + Vector2(scale, scale), shadow, scale)
	_draw_run(ci, text, pos, color, scale)

static func _draw_run(ci: CanvasItem, text: String, pos: Vector2, color: Color, scale: int) -> void:
	var x := floori(pos.x)
	var y := floori(pos.y)
	for ch in text:
		var key := ch if GLYPHS.has(ch) else ch.to_upper()
		var g: Array = GLYPHS.get(key, [])
		for row in g.size():
			var bits: String = g[row]
			for col in W:
				if bits[col] == "1":
					ci.draw_rect(Rect2(x + col * scale, y + row * scale, scale, scale), color)
		x += ADVANCE * scale
